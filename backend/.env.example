# Backend Environment Variables
# Copy to .env and fill in values

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://fcf_user:fcf_pass@localhost:5432/fcf_db"

# JWT
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Compiler Service
COMPILER_SERVICE_URL=http://localhost:8000
COMPILER_SERVICE_API_KEY=CHANGE_ME_COMPILER_SERVICE_SECRET

# Execution Defaults
DEFAULT_TIMEOUT_MS=5000
DEFAULT_MEMORY_LIMIT_MB=64

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
COMPILER_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=debug
